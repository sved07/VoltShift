# Copy to .env and fill in. Both keys are optional — VoltShift falls back to
# deterministic mock telemetry and a rule-based explainer when they are blank.
GEMINI_API_KEY=
ELECTRICITY_MAPS_KEY=

# Comma-separated list of origins allowed to call the API / open the WebSocket
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
